    "cc": [
      "array of email strings",
      "optional",
      "no",
      "At most 20 valid addresses",
      "create: []; PATCH: unchanged",
      "Caller \u2192 ticket_drafts.cc_emails"
    ],
    "bcc": [
      "array of email strings",
      "optional",
      "no",
      "At most 20 valid addresses",
      "create: []; PATCH: unchanged",
      "Caller \u2192 ticket_drafts.bcc_emails"
    ],
    "attachment_ids": [
      "array of UUID strings",
      "optional",
      "no",
      "At most 20 distinct owned uploads or files already reserved by this draft",
      "create: []; PATCH: unchanged",
      "Caller \u2192 ticket_draft_attachments.attachment_id; preserve caller order in position"
    ],
    "review_token": [
      "opaque string",
      "yes",
      "no",
      "Bound to principal, draft revision and effective preview context",
      "none",
      "Calculated review HMAC, never stored as draft content"
